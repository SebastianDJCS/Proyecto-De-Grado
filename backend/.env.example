# Copia este archivo a .env y completa los valores:
#   cp .env.example .env

# Neon (Postgres) - URL de conexión
DATABASE_URL=postgresql://USER:PASSWORD@HOST/nombre_db?sslmode=require

# Orígenes permitidos (separados por coma, SIN barra final).
# Debe incluir tu URL de Vercel para que el navegador no bloquee las llamadas:
CORS_ORIGINS=https://proyecto-de-grado-pi.vercel.app
