# Opcional. Copia este archivo como ".env" en la RAÍZ del proyecto
# (docker compose lo lee automáticamente para sobrescribir valores).
# Sin él, docker-compose.yml usa los valores por defecto.

# Segundos máximos del solver global
SOLVER_MAX_TIME_SECONDS=300

# Hilos de búsqueda: 0 = usar todos los vCPU disponibles
SOLVER_WORKERS=0

# Límite de RAM del solver en MB: 0 = sin límite.
# Si tu VM tiene <= 2 GB, usa 1500 para evitar OOM:
SOLVER_MAX_MEMORY_MB=0
